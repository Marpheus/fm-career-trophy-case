{
  "name": "fm-career-trophy-case",
  "private": true,
  "description": "World map tracker for a Football Manager world-conquest save.",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run copy:flags && vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "format": "prettier --write .",
    "build:map": "node scripts/build-map.mjs",
    "copy:flags": "node scripts/copy-flags.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "flag-icons": "^7.6.0",
    "topojson-client": "^3.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.3",
    "@tailwindcss/vite": "^4.0.0",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "mapshaper": "^0.7.89",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
