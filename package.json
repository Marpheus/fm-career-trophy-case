    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "mapshaper": "^0.6.102",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
